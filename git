# check status
git status
git fetch

# update local repo from gihub
git pull --rebase origin main # if diverged

# add, rm and commit
git add .
git rm --cached .DS_Store
git commit -m "Made changes"

# reset last commit
git reset HEAD~1
git reset --hard HEAD~1 # discard changes

# push local changes to github
git push origin main

# create local (repo-level) alias for script, supports passing commands directly or via file, "!" makes it a shell command
git config --local alias.review '!scripts/file.sh'
git config --local alias.hello '!echo jello | tr j H'
