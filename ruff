# check changed files (staged & unstaged), GNU-specific
git diff --name-only --diff-filter=ACMR -z HEAD \
  | grep -z '\.py$' \
  | grep -zv '^tests/' \
  | xargs -0 -r uv run ruff check

# same as previous but will also work on MacOS, don't miss #files[@]... line 
files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(git diff --name-only --diff-filter=ACMR -z HEAD -- '*.py' ':!tests/*')

if [ ${#files[@]} -eq 0 ]; then
  echo "No changed Python files to check."
  exit 0
fi

exec uv run ruff check "${files[@]}"
